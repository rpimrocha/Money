@page "/login"
@layout EmptyLayout

<PageTitle>Money APP - Registrar</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6" > 
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pb-8 pt-8">
                <img src="imagens/money.png" alt="Money Controle Financeiro" width="200" />
            </div>
            <MudForm @ref="mudForm">
                <MudTextField T="string" Label="E-mail" InputType="InputType.Email"
                              Required="true" Placeholder="E-mail" RequiredError="Informe o e-mail"
                              Validation="@(new EmailAddressAttribute { ErrorMessage="Email inválido" })" />
                <MudTextField T="string" Label="Senha" InputType="InputType.Password"
                              Required="true" Placeholder="Senha" RequiredError="Informe a senha" />
            </MudForm>
            <div class="d-flex mt-8">
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Entrar</MudButton>
                <MudSpacer/>
                <MudButton Href="/registro" >Registrar</MudButton>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    MudForm? mudForm;
}