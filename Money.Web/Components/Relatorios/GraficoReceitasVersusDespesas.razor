@page "/relatorios/grafico-receitas-versus-despesas"
@inherits GraficoReceitasVersusDespesasPage

@if (IsLoading)
{
    <MudPaper Class="pa-8 mt-4">
        <MudSkeleton Height="55px" />
        <MudSkeleton Height="110px" />
        <MudSkeleton Height="55px" />
        <MudSkeleton Height="110px" />
        <MudSkeleton Height="55px" />
    </MudPaper>
}
else
{
    @if (ChartSeries is null)
    {
        <MudPaper Class="pa-8 mt-4">
            <MudText Typo="Typo.h6">Nenhum dado encontrado.</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-8 mt-4">
            <MudChart ChartOptions="@ChartOptions" ChartType="ChartType.Line" ChartSeries="@ChartSeries" 
                XAxisLabels="@Rotulos.ToArray()" CanHideSeries="true" Width="100%" Height="350px" />
        </MudPaper>
    }
}